/* ============================================================================
 *  SNAKE AI — V4 单文件重构版
 *  架构（自上而下）：
 *    1.  GameEngine         纯游戏逻辑 + 死因记录
 *    2.  V4DeathReason      死因枚举（驱动策略自调整）
 *    3.  V4Goal             多目标枚举
 *    4.  Features           36 维状态特征
 *    5.  SpaceAnalyzer      空间评估（区域/自由度/走廊）
 *    6.  DangerEvaluator    危险评估（空间 + 失败记忆 + 风险偏好）
 *    7.  LoopDetector       循环检测（滑动窗口重访）
 *    8.  StateHasher        状态哈希（5x5 局部窗口）
 *    9.  V4FailureMemory    失败长期记忆（LRU，位置/全状态双索引）
 *   10.  CausalHistory      死亡因果归因（衰减回溯）
 *   11.  V4StrategyGenome   基因性格（随死因自调整 + GA 进化）
 *   12.  MultiGoalPlanner   多目标策略规划器（核心决策）
 *   13.  Heuristic          BFS 工具（洪泛/尾可达）
 *   14.  Brain              D3QN 手写网络（Dueling + Double）
 *   15.  ReplayBuffer       优先经验回放（PER）
 *   16.  GaTrainer           神经进化（Brain + 基因组共进化）
 *   17.  DqnTrainer          DQN 训练器（策略仲裁 + 死因反馈）
 *   18.  TrainingController  多线程训练 + 看门狗 + 原子持久化
 *   19.  SnakeView           UI / 渲染 / 触摸 / 帧循环
 * ==========================================================================*/

// ----------------------------- 1. 游戏引擎 ---------------------------------

enum class StepResult { MOVED, ATE, DIED }

// ----------------------------- 2. 死因分类 ---------------------------------

enum class V4DeathReason { WALL, SELF, TRAP_PREDICTED, STARVATION, FULL_BOARD, UNKNOWN }

fun reasonLabel(r: V4DeathReason): String = when (r) {
    V4DeathReason.WALL -> "撞墙"
    V4DeathReason.SELF -> "咬身"
    V4DeathReason.TRAP_PREDICTED -> "被困"
    V4DeathReason.STARVATION -> "饿死"
    V4DeathReason.FULL_BOARD -> "通关!"
    V4DeathReason.UNKNOWN -> "—"
}

// ----------------------------- 3. 多目标 -----------------------------------

enum class V4Goal { SURVIVE, FOOD, SPACE, TAIL_CHASE, LOOP_BREAK, EXPLORE }

fun goalLabel(g: V4Goal): String = when (g) {
    V4Goal.SURVIVE -> "生存"
    V4Goal.FOOD -> "觅食"
    V4Goal.SPACE -> "控场"
    V4Goal.TAIL_CHASE -> "尾行"
    V4Goal.LOOP_BREAK -> "破环"
    V4Goal.EXPLORE -> "探索"
}

class GameEngine(val w: Int = 15, val h: Int = 15) {
    companion object {
        val DIRS = arrayOf(0 to -1, 1 to 0, 0 to 1, -1 to 0) // 0上 1右 2下 3左
    }

    val snake = ArrayDeque<Pair<Int, Int>>()
    var food = 0 to 0
    var dir = 1
    var alive = false
    var score = 0
    var stepsSinceFood = 0
    var totalSteps = 0L
    var deathReason = V4DeathReason.UNKNOWN
    val random = Random()

    fun occupied(x: Int, y: Int): Boolean {
        for (c in snake) if (c.first == x && c.second == y) return true
        return false
    }

    fun reset() {
        snake.clear()
        val sx = w / 2; val sy = h / 2
        snake.addLast(sx to sy)
        snake.addLast((sx - 1) to sy)
        snake.addLast((sx - 2) to sy)
        dir = 1
        score = 0
        stepsSinceFood = 0
        totalSteps = 0
        deathReason = V4DeathReason.UNKNOWN
        alive = true
        spawnFood()
    }

    fun spawnFood() {
        var attempts = 0
        while (attempts < 200) {
            val x = random.nextInt(w); val y = random.nextInt(h)
            if (!occupied(x, y)) { food = x to y; return }
            attempts++
        }
        val free = ArrayList<Pair<Int, Int>>(w * h)
        for (y in 0 until h) for (x in 0 until w) if (!occupied(x, y)) free.add(x to y)
        if (free.isEmpty()) { deathReason = V4DeathReason.FULL_BOARD; alive = false; return }
        food = free[random.nextInt(free.size)]
    }

    fun head(): Pair<Int, Int> = snake.first()
    fun tail(): Pair<Int, Int> = snake.last()

    /** 下一步格子（含掉头拦截），不移动 */
    fun nextCell(d: Int): Pair<Int, Int>? {
        val nd = if ((d + 2) % 4 == dir && snake.size > 1) dir else d
        val (dx, dy) = DIRS[nd]
        val h = head()
        val nx = h.first + dx; val ny = h.second + dy
        if (nx < 0 || ny < 0 || nx >= w || ny >= h) return null
        return nx to ny
    }

    fun step(d: Int): StepResult {
        if (!alive) return StepResult.DIED
        if ((d + 2) % 4 != dir || snake.size <= 1) dir = d
        val (dx, dy) = DIRS[dir]
        val h = head()
        val nx = h.first + dx; val ny = h.second + dy
        if (nx < 0 || ny < 0 || nx >= w || ny >= h) {
            deathReason = V4DeathReason.WALL; alive = false; return StepResult.DIED
        }
        val eating = nx == food.first && ny == food.second
        val willHitBody = if (eating) occupied(nx, ny) else {
            var hit = false
            for (i in 0 until snake.size - 1) {
                val c = snake.elementAt(i)
                if (c.first == nx && c.second == ny) { hit = true; break }
            }
            hit
        }
        if (willHitBody) { deathReason = V4DeathReason.SELF; alive = false; return StepResult.DIED }
        snake.addFirst(nx to ny)
        totalSteps++
        return if (eating) {
            score++; stepsSinceFood = 0
            spawnFood()
            if (!alive) StepResult.DIED else StepResult.ATE
        } else {
            stepsSinceFood++
            if (stepsSinceFood > w * h * 2) {
                deathReason = V4DeathReason.STARVATION; alive = false; StepResult.DIED
            } else StepResult.MOVED
        }
    }

    fun manhattanToFood(x: Int, y: Int): Int = abs(x - food.first) + abs(y - food.second)
}

// ----------------------------- 4. 特征提取 ----------------------------------

object Features {
    const val SIZE = 36

    fun extract(e: GameEngine, dir: Int): DoubleArray {
        val f = DoubleArray(SIZE)
        val head = e.head()
        var free = 0
        for (y in 0 until e.h) for (x in 0 until e.w) if (!e.occupied(x, y)) free++
        val freeFrac = free.toDouble() / (e.w * e.h)

        var i = 0
        for (d in 0 until 4) {
            val c = e.nextCell(d)
            f[i++] = if (c == null || e.occupied(c.first, c.second)) 1.0 else 0.0
        }
        for (d in 0 until 4) {
            val c = e.nextCell(d)
            val area = if (c == null || e.occupied(c.first, c.second)) 0
            else Heuristic.floodArea(e, c.first, c.second)
            f[i++] = (kotlin.math.ln(1.0 + area) / 8.0).coerceAtMost(1.0)
        }
        val fdx = (e.food.first - head.first).toDouble() / e.w
        val fdy = (e.food.second - head.second).toDouble() / e.h
        f[i++] = fdx; f[i++] = fdy
        val (dx, dy) = GameEngine.DIRS[dir]
        f[i++] = (fdx * dx + fdy * dy).coerceIn(-1.0, 1.0)
        f[i++] = (fdx * -dy + fdy * dx).coerceIn(-1.0, 1.0)
        val t = e.tail()
        f[i++] = (t.first - head.first).toDouble() / e.w
        f[i++] = (t.second - head.second).toDouble() / e.h
        f[i++] = e.snake.size.toDouble() / (e.w * e.h)
        f[i++] = min(1.0, e.stepsSinceFood / 200.0)
        f[16 + dir] = 1.0; i = 20
        for (oy in -1..1) for (ox in -1..1) {
            if (ox == 0 && oy == 0) continue
            val x = head.first + ox; val y = head.second + oy
            f[i++] = if (x < 0 || y < 0 || x >= e.w || y >= e.h || e.occupied(x, y)) 1.0 else 0.0
        }
        f[i++] = 1.0
        f[i++] = freeFrac
        for (d in 0 until 4) {
            val c = e.nextCell(d)
            f[i++] = if (c == null) 1.0 else e.manhattanToFood(c.first, c.second).toDouble() / (e.w + e.h)
        }
        f[i++] = if (e.food.first == head.first || e.food.second == head.second) 1.0 else 0.0
        f[i] = min(1.0, e.score / 50.0)
        return f
    }
}

// ----------------------------- 5. 空间评估 ----------------------------------

object SpaceAnalyzer {
    data class SpaceReport(
        val area: Int,        // 可达区域面积
        val freeDegree: Int,  // 起点一步自由度
        val corridorCells: Int, // 走廊/死端格数
        val ratio: Double,    // 区域面积 / 剩余自由格
        val open: Boolean     // 区域能否容纳整条蛇
    )

    fun analyze(e: GameEngine, x: Int, y: Int): SpaceReport {
        if (x < 0 || y < 0 || x >= e.w || y >= e.h || e.occupied(x, y))
            return SpaceReport(0, 0, 0, 0.0, false)
        val seen = BooleanArray(e.w * e.h)
        val q = ArrayDeque<Int>()
        q.addLast(y * e.w + x); seen[y * e.w + x] = true
        var area = 0; var corridor = 0
        while (q.isNotEmpty()) {
            val idx = q.removeFirst(); area++
            val cx = idx % e.w; val cy = idx / e.w
            var freeDeg = 0
            for (d in GameEngine.DIRS) {
                val nx = cx + d.first; val ny = cy + d.second
                if (nx < 0 || ny < 0 || nx >= e.w || ny >= e.h || e.occupied(nx, ny)) continue
                freeDeg++
                val ni = ny * e.w + nx
                if (!seen[ni]) { seen[ni] = true; q.addLast(ni) }
            }
            if (freeDeg <= 1) corridor++
        }
        var startDeg = 0
        for (d in GameEngine.DIRS) {
            val nx = x + d.first; val ny = y + d.second
            if (nx < 0 || ny < 0 || nx >= e.w || ny >= e.h || e.occupied(nx, ny)) continue
            startDeg++
        }
        val freeTotal = max(1, e.w * e.h - e.snake.size + 1)
        return SpaceReport(area, startDeg, corridor, area.toDouble() / freeTotal, area >= e.snake.size)
    }
}

// ----------------------------- 6. 危险评估 ----------------------------------

object DangerEvaluator {
    /** 综合危险度：空间不足 + 走廊 + 失败记忆 + 风险偏好调制 */
    fun danger(e: GameEngine, x: Int, y: Int, dir: Int, g: V4StrategyGenome, failure: V4FailureMemory): Double {
        if (x < 0 || y < 0 || x >= e.w || y >= e.h || e.occupied(x, y)) return 1.0
        val sr = SpaceAnalyzer.analyze(e, x, y)
        var d = 0.0
        if (!sr.open) d += 0.45 + (1.0 - sr.ratio) * 0.3      // 空间装不下蛇
        d += min(0.25, sr.corridorCells * 0.04)               // 走廊惩罚
        d += failure.dangerAt(x, y, dir)                       // 历史死亡记忆
        d *= (1.15 - g.riskAppetite * 0.5)                     // 性格调制
        return d.coerceIn(0.0, 1.5)
    }
}

// ----------------------------- 7. 循环检测 ----------------------------------

class LoopDetector(private val windowCap: Int = 48) {
    private val recent = ArrayDeque<Int>()
    private val counts = HashMap<Int, Int>()

    private fun key(x: Int, y: Int) = (y shl 8) or x

    fun record(e: GameEngine) {
        val h = e.head()
        val k = key(h.first, h.second)
        recent.addLast(k)
        counts[k] = (counts[k] ?: 0) + 1
        if (recent.size > windowCap) {
            val old = recent.removeFirst()
            val c = counts[old]
            if (c != null) { if (c <= 1) counts.remove(old) else counts[old] = c - 1 }
        }
    }

    fun visitCount(x: Int, y: Int): Int = counts[key(x, y)] ?: 0

    /** 该格近期重访惩罚 [0,1] */
    fun visitPenalty(x: Int, y: Int): Double = min(1.0, visitCount(x, y) / 3.0)

    fun looping(): Boolean = (counts.values.maxOrNull() ?: 0) >= 3

    fun reset() { recent.clear(); counts.clear() }
}

// ----------------------------- 8. 状态哈希 ----------------------------------

object StateHasher {
    /** 头部 5x5 局部窗口 + 方向 + 食物 + 长度档 的 64 位哈希 */
    fun hash(e: GameEngine, dir: Int): Long {
        var h = 1125899906842597L
        h = h * 31 + dir
        h = h * 31 + e.food.first * 16 + e.food.second
        val hd = e.head()
        for (oy in -2..2) for (ox in -2..2) {
            val x = hd.first + ox; val y = hd.second + oy
            val v = when {
                x < 0 || y < 0 || x >= e.w || y >= e.h -> 2
                e.occupied(x, y) -> 1
                else -> 0
            }
            h = h * 31 + v
        }
        h = h * 31 + min(7, e.snake.size)
        return h
    }
}

// ----------------------------- 9. 失败长期记忆 -------------------------------

class V4FailureMemory(private val cap: Int = 20000) {
    class Rec(var deaths: Int, var reason: V4DeathReason, var length: Int)

    private val byPos = HashMap<Int, Rec>()      // (x,y,dir) 粗索引
    private val byHash = HashMap<Long, Int>()     // 全状态精确索引
    private val lru = ArrayDeque<Int>()
    var totalDeaths = 0L; private set

    private fun posKey(x: Int, y: Int, dir: Int) = ((y * 64 + x) * 5 + dir)

    fun record(x: Int, y: Int, dir: Int, hash: Long, reason: V4DeathReason, length: Int) {
        val k = posKey(x, y, dir)
        val r = byPos.getOrPut(k) { Rec(0, reason, length) }
        r.deaths++
        if (length > r.length) r.length = length
        r.reason = reason
        byHash[hash] = (byHash[hash] ?: 0) + 1
        if (byHash.size > 50000) byHash.clear() // 防膨胀
        lru.addLast(k)
        if (lru.size > cap) {
            val old = lru.removeFirst()
            val rec = byPos[old]
            if (rec != null) {
                rec.deaths--
                if (rec.deaths <= 0) byPos.remove(old)
            }
        }
        totalDeaths++
    }

    /** 该位置+方向的历史死亡危险 [0,1] */
    fun dangerAt(x: Int, y: Int, dir: Int): Double =
        min(1.0, (byPos[posKey(x, y, dir)]?.deaths ?: 0) / 5.0)

    /** 精确状态危险（几乎不用，但保留索引） */
    fun exactDanger(hash: Long): Double =
        min(1.0, (byHash[hash] ?: 0) / 3.0)

    fun size(): Int = byPos.size

    fun serialize(dos: DataOutputStream, limit: Int = 2000) {
        val entries = byPos.entries.sortedByDescending { it.value.deaths }.take(limit)
        dos.writeInt(entries.size)
        for ((k, r) in entries) {
            dos.writeInt(k)
            dos.writeInt(r.deaths)
            dos.writeByte(r.reason.ordinal)
            dos.writeShort(r.length.coerceIn(0, 32767))
        }
    }

    fun deserialize(dis: DataInputStream) {
        val n = dis.readInt()
        if (n < 0 || n > 100000) return
        repeat(n) {
            val k = dis.readInt()
            val deaths = dis.readInt()
            val reason = V4DeathReason.values()[dis.readByte().toInt().coerceIn(0, V4DeathReason.values().size - 1)]
            val len = dis.readShort().toInt()
            byPos[k] = Rec(deaths, reason, len)
            repeat(deaths.coerceAtMost(3)) { lru.addLast(k) }
            totalDeaths += deaths
        }
    }
}

// ----------------------------- 10. 因果归因 ---------------------------------

class CausalHistory(private val cap: Int = 32) {
    class Cause(
        val step: Long, val hash: Long,
        val x: Int, val y: Int, val dir: Int, val action: Int
    )

    private val ring = ArrayDeque<Cause>()

    /** 决策时刻记录（step 之前调用） */
    fun record(e: GameEngine, action: Int) {
        val h = e.head()
        ring.addLast(Cause(e.totalSteps, StateHasher.hash(e, e.dir), h.first, h.second, e.dir, action))
        if (ring.size > cap) ring.removeFirst()
    }

    /** 死亡回溯：越接近死亡权重越高（1.0 → 0.85^n） */
    fun onDeath(cb: (Cause, Double) -> Unit) {
        var w = 1.0
        for (i in ring.indices) {
            val c = ring.elementAt(ring.size - 1 - i)
            cb(c, w)
            w *= 0.85
        }
    }

    fun reset() = ring.clear()
}

// ----------------------------- 11. 基因性格 ---------------------------------

class V4StrategyGenome {
    var foodGreed = 1.0        // 觅食贪婪
    var safetyWeight = 1.2     // 安全权重
    var spaceWeight = 0.8      // 空间控制
    var tailChaseWeight = 0.4  // 尾行守成
    var loopAversion = 0.5     // 循环厌恶
    var riskAppetite = 0.3     // 风险偏好
    var dqnTrust = 0.3         // 对神经网络的信任度
    var adaptRate = 0.06       // 自调整步长

    private fun vector() = doubleArrayOf(
        foodGreed, safetyWeight, spaceWeight, tailChaseWeight,
        loopAversion, riskAppetite, dqnTrust, adaptRate
    )

    private fun load(v: DoubleArray) {
        foodGreed = v[0]; safetyWeight = v[1]; spaceWeight = v[2]; tailChaseWeight = v[3]
        loopAversion = v[4]; riskAppetite = v[5]; dqnTrust = v[6]; adaptRate = v[7]
        normalize()
    }

    fun normalize() {
        foodGreed = foodGreed.coerceIn(0.05, 3.0)
        safetyWeight = safetyWeight.coerceIn(0.05, 3.0)
        spaceWeight = spaceWeight.coerceIn(0.05, 3.0)
        tailChaseWeight = tailChaseWeight.coerceIn(0.05, 3.0)
        loopAversion = loopAversion.coerceIn(0.05, 3.0)
        riskAppetite = riskAppetite.coerceIn(0.05, 1.0)
        dqnTrust = dqnTrust.coerceIn(0.05, 1.0)
        adaptRate = adaptRate.coerceIn(0.01, 0.2)
    }

    /** 基因性格标签 */
    fun personality(): String {
        val m = mapOf(
            "觅食" to foodGreed, "生存" to safetyWeight,
            "控场" to spaceWeight, "守成" to tailChaseWeight
        )
        val top = m.maxByOrNull { it.value }!!.key
        return when {
            top == "觅食" && riskAppetite > 0.5 -> "激进觅食型"
            top == "生存" -> "稳健生存型"
            top == "控场" -> "空间控制型"
            top == "守成" -> "尾行守成型"
            else -> "均衡型"
        }
    }

    /** 策略自调整：按死因修正基因 */
    fun adjust(reason: V4DeathReason) {
        val a = adaptRate
        when (reason) {
            V4DeathReason.WALL -> {
                safetyWeight += a * 2
                riskAppetite -= a
            }
            V4DeathReason.SELF -> {
                spaceWeight += a * 2
                tailChaseWeight += a
            }
            V4DeathReason.TRAP_PREDICTED -> {
                tailChaseWeight += a * 2
                spaceWeight += a
                foodGreed -= a
            }
            V4DeathReason.STARVATION -> {
                foodGreed += a * 2
                loopAversion += a
            }
            V4DeathReason.FULL_BOARD, V4DeathReason.UNKNOWN -> { /* 通关/未知不罚 */ }
        }
        normalize()
    }

    fun clone(): V4StrategyGenome = V4StrategyGenome().also { it.load(vector()) }
    fun copyFrom(o: V4StrategyGenome) = load(o.vector())

    fun mutate(rnd: Random, rate: Double = 0.15, sigma: Double = 0.08) {
        val v = vector()
        for (i in v.indices) if (rnd.nextDouble() < rate) v[i] += rnd.nextGaussian() * sigma
        load(v)
    }

    companion object {
        fun crossover(a: V4StrategyGenome, b: V4StrategyGenome, rnd: Random): V4StrategyGenome {
            val va = a.vector(); val vb = b.vector()
            val c = DoubleArray(va.size) { if (rnd.nextBoolean()) va[it] else vb[it] }
            return V4StrategyGenome().also { it.load(c) }
        }

        fun serialize(g: V4StrategyGenome, dos: DataOutputStream) {
            for (v in g.vector()) dos.writeDouble(v)
        }

        fun deserialize(dis: DataInputStream): V4StrategyGenome? = try {
            val g = V4StrategyGenome()
            val v = DoubleArray(8)
            for (i in v.indices) v[i] = dis.readDouble()
            g.load(v); g
        } catch (t: Throwable) { Log.w("SnakeAI", "genome deserialize failed", t); null }
    }
}

// ----------------------------- 12. 多目标规划器 -----------------------------

object MultiGoalPlanner {
    data class DirEval(
        val dir: Int,
        var survival: Double = 0.0, var food: Double = 0.0, var space: Double = 0.0,
        var tailChase: Double = 0.0, var loopBreak: Double = 0.0, var danger: Double = 0.0,
        var total: Double = 0.0, var goal: V4Goal = V4Goal.SURVIVE
    )

    fun evaluate(e: GameEngine, g: V4StrategyGenome, loop: LoopDetector, failure: V4FailureMemory): Array<DirEval> {
        val evals = Array(4) { DirEval(it) }
        val maxD = (e.w + e.h).toDouble()
        val tail = e.tail()
        val tight = e.snake.size > (e.w * e.h) / 2  // 后期：空间紧张

        for (d in 0 until 4) {
            val ev = evals[d]
            if ((d + 2) % 4 == e.dir && e.snake.size > 1) { ev.total = Double.NEGATIVE_INFINITY; continue }
            val c = e.nextCell(d) ?: run { ev.total = Double.NEGATIVE_INFINITY; ev.danger = 1.0; continue }
            if (e.occupied(c.first, c.second)) { ev.total = Double.NEGATIVE_INFINITY; ev.danger = 1.0; continue }

            val sr = SpaceAnalyzer.analyze(e, c.first, c.second)
            val dist = e.manhattanToFood(c.first, c.second)
            val tailDist = abs(c.first - tail.first) + abs(c.second - tail.second)
            val tailOk = if (Heuristic.tailReachable(e, c.first, c.second)) 1.0 else 0.0

            // —— 各目标组件 ——
            ev.survival = min(1.0, sr.area.toDouble() / (e.snake.size + 2)) * 0.7 + tailOk * 0.3
            ev.food = (maxD - dist) / maxD
            ev.space = min(1.0, kotlin.math.ln(1.0 + sr.area) / 6.0)
            ev.tailChase = 1.0 - min(1.0, tailDist / maxD)
            ev.loopBreak = 1.0 - loop.visitPenalty(c.first, c.second)
            ev.danger = DangerEvaluator.danger(e, c.first, c.second, d, g, failure)

            // 吃食物陷阱：食物格所在区域装不下蛇还硬吃
            if (c == e.food && sr.area < e.snake.size * 1.2) ev.danger += 0.25

            // —— 多目标加权合成 ——
            var w = 0.0
            w += g.safetyWeight * (ev.survival - ev.danger * 0.8)
            w += g.foodGreed * ev.food * (if (tight) 0.5 else 1.0)
            w += g.spaceWeight * ev.space
            w += g.tailChaseWeight * (if (tight) 2.0 else 0.3) * ev.tailChase
            w += g.loopAversion * (ev.loopBreak - 0.5)
            ev.total = w
            ev.goal = dominantOf(ev)
        }
        return evals
    }

    private fun dominantOf(ev: DirEval): V4Goal = when (maxOf(ev.survival, ev.food, ev.space, ev.tailChase)) {
        ev.survival -> V4Goal.SURVIVE
        ev.food -> V4Goal.FOOD
        ev.space -> V4Goal.SPACE
        else -> V4Goal.TAIL_CHASE
    }

    fun bestAction(e: GameEngine, g: V4StrategyGenome, loop: LoopDetector, failure: V4FailureMemory): Int {
        val evals = evaluate(e, g, loop, failure)
        var best = e.dir; var bv = Double.NEGATIVE_INFINITY
        for (d in 0 until 4) if (evals[d].total > bv) { bv = evals[d].total; best = d }
        if (bv == Double.NEGATIVE_INFINITY) {
            // 全方向即死：选任意合法方向（交给 step 结束）
            for (d in 0 until 4) {
                if ((d + 2) % 4 == e.dir && e.snake.size > 1) continue
                return d
            }
        }
        return best
    }
}

// ----------------------------- 13. BFS 工具 ---------------------------------

object Heuristic {

    fun floodArea(e: GameEngine, sx: Int, sy: Int): Int {
        if (sx < 0 || sy < 0 || sx >= e.w || sy >= e.h) return 0
        val seen = BooleanArray(e.w * e.h)
        val q = ArrayDeque<Int>()
        q.addLast(sy * e.w + sx); seen[sy * e.w + sx] = true
        var cnt = 0
        while (q.isNotEmpty()) {
            val idx = q.removeFirst(); cnt++
            val x = idx % e.w; val y = idx / e.w
            for (d in GameEngine.DIRS) {
                val nx = x + d.first; val ny = y + d.second
                if (nx < 0 || ny < 0 || nx >= e.w || ny >= e.h) continue
                val ni = ny * e.w + nx
                if (!seen[ni] && !e.occupied(nx, ny)) { seen[ni] = true; q.addLast(ni) }
            }
        }
        return cnt
    }

    fun tailReachable(e: GameEngine, fromX: Int, fromY: Int): Boolean {
        val t = e.tail()
        if (fromX < 0 || fromY < 0 || fromX >= e.w || fromY >= e.h) return false
        val seen = BooleanArray(e.w * e.h)
        val q = ArrayDeque<Int>()
        q.addLast(fromY * e.w + fromX); seen[fromY * e.w + fromX] = true
        while (q.isNotEmpty()) {
            val idx = q.removeFirst()
            val x = idx % e.w; val y = idx / e.w
            if (x == t.first && y == t.second) return true
            for (d in GameEngine.DIRS) {
                val nx = x + d.first; val ny = y + d.second
                if (nx < 0 || ny < 0 || nx >= e.w || ny >= e.h) continue
                val ni = ny * e.w + nx
                if (!seen[ni] && !e.occupied(nx, ny)) { seen[ni] = true; q.addLast(ni) }
            }
        }
        return false
    }
}

// ----------------------------- 14. D3QN 网络 ----------------------------------

class Brain(
    val inN: Int = Features.SIZE,
    val h1: Int = 48,
    val h2: Int = 32,
    val actN: Int = 4
) {
    var w1 = Array(h1) { DoubleArray(inN) }; var b1 = DoubleArray(h1)
    var w2 = Array(h2) { DoubleArray(h1) }; var b2 = DoubleArray(h2)
    var va = DoubleArray(h2); var vb = 0.0
    var aa = Array(actN) { DoubleArray(h2) }; var ab = DoubleArray(actN)

    private var gw1 = Array(h1) { DoubleArray(inN) }; private var gb1 = DoubleArray(h1)
    private var gw2 = Array(h2) { DoubleArray(h1) }; private var gb2 = DoubleArray(h2)
    private var gva = DoubleArray(h2); private var gvb = 0.0
    private var gaa = Array(actN) { DoubleArray(h2) }; private var gab = DoubleArray(actN)

    private var z1 = DoubleArray(h1); private var z2 = DoubleArray(h2)
    private val rnd = Random()

    init { randomize() }

    fun randomize() {
        for (j in 0 until h1) { for (k in 0 until inN) w1[j][k] = rnd.nextGaussian() / sqrt(inN.toDouble()); b1[j] = 0.0 }
        for (j in 0 until h2) { for (k in 0 until h1) w2[j][k] = rnd.nextGaussian() / sqrt(h1.toDouble()); b2[j] = 0.0 }
        for (j in 0 until h2) va[j] = rnd.nextGaussian() / sqrt(h2.toDouble())
        vb = 0.0
        for (m in 0 until actN) {
            for (j in 0 until h2) aa[m][j] = rnd.nextGaussian() / sqrt(h2.toDouble())
            ab[m] = 0.0
        }
        clearGrads()
    }

    fun forward(x: DoubleArray): DoubleArray {
        for (j in 0 until h1) {
            var s = b1[j]
            val wj = w1[j]
            for (k in 0 until inN) if (x[k] != 0.0) s += wj[k] * x[k]
            z1[j] = if (s > 0) s else 0.0
        }
        for (j in 0 until h2) {
            var s = b2[j]
            val wj = w2[j]
            for (k in 0 until h1) if (z1[k] > 0) s += wj[k] * z1[k]
            z2[j] = if (s > 0) s else 0.0
        }
        var v = vb
        for (j in 0 until h2) v += va[j] * z2[j]
        val adv = DoubleArray(actN)
        var mean = 0.0
        for (m in 0 until actN) {
            var s = ab[m]
            val am = aa[m]
            for (j in 0 until h2) s += am[j] * z2[j]
            adv[m] = s; mean += s
        }
        mean /= actN
        val q = DoubleArray(actN)
        for (m in 0 until actN) q[m] = v + adv[m] - mean
        return q
    }

    fun backward(x: DoubleArray, action: Int, target: Double, weight: Double): Double {
        val q = forward(x)
        val err = q[action] - target
        if (!err.isFinite()) return 0.0
        val d = (if (abs(err) <= 1.0) err else kotlin.math.sign(err)) * weight
        val dClip = d.coerceIn(-5.0, 5.0)
        val da = DoubleArray(actN)
        for (m in 0 until actN) da[m] = dClip * (if (m == action) 1.0 else 0.0) - dClip / actN
        val dv = dClip
        val dz2 = DoubleArray(h2)
        for (j in 0 until h2) { gva[j] += dv * z2[j]; dz2[j] += dv * va[j] }
        gvb += dv
        for (m in 0 until actN) {
            val dam = da[m]; gab[m] += dam
            val am = aa[m]; val gam = gaa[m]
            for (j in 0 until h2) { gam[j] += dam * z2[j]; dz2[j] += dam * am[j] }
        }
        val dz1 = DoubleArray(h1)
        for (j in 0 until h2) {
            if (z2[j] <= 0) continue
            val d2 = dz2[j]; gb2[j] += d2
            val wj = w2[j]; val gj = gw2[j]
            for (k in 0 until h1) { gj[k] += d2 * z1[k]; dz1[k] += d2 * wj[k] }
        }
        for (j in 0 until h1) {
            if (z1[j] <= 0) continue
            val d1 = dz1[j]; gb1[j] += d1
            val wj = w1[j]; val gj = gw1[j]
            for (k in 0 until inN) if (x[k] != 0.0) gj[k] += d1 * x[k]
        }
        return err
    }

    fun applyGrads(lr: Double, batch: Int) {
        val inv = lr / max(1, batch)
        for (j in 0 until h1) {
            b1[j] -= (gb1[j] * inv).coerceIn(-0.05, 0.05)
            for (k in 0 until inN) w1[j][k] -= (gw1[j][k] * inv).coerceIn(-0.05, 0.05)
        }
        for (j in 0 until h2) {
            b2[j] -= (gb2[j] * inv).coerceIn(-0.05, 0.05)
            for (k in 0 until h1) w2[j][k] -= (gw2[j][k] * inv).coerceIn(-0.05, 0.05)
        }
        for (j in 0 until h2) va[j] -= (gva[j] * inv).coerceIn(-0.05, 0.05)
        vb -= (gvb * inv).coerceIn(-0.05, 0.05)
        for (m in 0 until actN) {
            ab[m] -= (gab[m] * inv).coerceIn(-0.05, 0.05)
            for (j in 0 until h2) aa[m][j] -= (gaa[m][j] * inv).coerceIn(-0.05, 0.05)
        }
        clearGrads()
    }

    fun clearGrads() {
        for (j in 0 until h1) { gb1[j] = 0.0; java.util.Arrays.fill(gw1[j], 0.0) }
        for (j in 0 until h2) { gb2[j] = 0.0; java.util.Arrays.fill(gw2[j], 0.0) }
        java.util.Arrays.fill(gva, 0.0); gvb = 0.0
        for (m in 0 until actN) { gab[m] = 0.0; java.util.Arrays.fill(gaa[m], 0.0) }
    }

    fun copyFrom(o: Brain) {
        for (j in 0 until h1) { System.arraycopy(o.w1[j], 0, w1[j], 0, inN); b1[j] = o.b1[j] }
        for (j in 0 until h2) { System.arraycopy(o.w2[j], 0, w2[j], 0, h1); b2[j] = o.b2[j] }
        System.arraycopy(o.va, 0, va, 0, h2); vb = o.vb
        for (m in 0 until actN) { System.arraycopy(o.aa[m], 0, aa[m], 0, h2); ab[m] = o.ab[m] }
    }

    fun cloneBrain(): Brain { val b = Brain(inN, h1, h2, actN); b.copyFrom(this); return b }

    fun mutate(rate: Double, sigma: Double, rnd: Random) {
        if (rnd.nextDouble() < rate) for (j in 0 until h1) for (k in 0 until inN) w1[j][k] += rnd.nextGaussian() * sigma
        if (rnd.nextDouble() < rate) for (j in 0 until h2) for (k in 0 until h1) w2[j][k] += rnd.nextGaussian() * sigma
        if (rnd.nextDouble() < rate) for (j in 0 until h2) va[j] += rnd.nextGaussian() * sigma
        for (m in 0 until actN) if (rnd.nextDouble() < rate) for (j in 0 until h2) aa[m][j] += rnd.nextGaussian() * sigma
    }

    companion object {
        fun crossover(a: Brain, b: Brain, rnd: Random): Brain {
            val c = Brain(a.inN, a.h1, a.h2, a.actN)
            for (j in 0 until a.h1) {
                if (rnd.nextBoolean()) { System.arraycopy(a.w1[j], 0, c.w1[j], 0, a.inN); c.b1[j] = a.b1[j] }
                else { System.arraycopy(b.w1[j], 0, c.w1[j], 0, a.inN); c.b1[j] = b.b1[j] }
            }
            for (j in 0 until a.h2) {
                if (rnd.nextBoolean()) { System.arraycopy(a.w2[j], 0, c.w2[j], 0, a.h1); c.b2[j] = a.b2[j] }
                else { System.arraycopy(b.w2[j], 0, c.w2[j], 0, a.h1); c.b2[j] = b.b2[j] }
            }
            for (j in 0 until a.h2) c.va[j] = if (rnd.nextBoolean()) a.va[j] else b.va[j]
            for (m in 0 until a.actN) {
                for (j in 0 until a.h2) c.aa[m][j] = if (rnd.nextBoolean()) a.aa[m][j] else b.aa[m][j]
                c.ab[m] = if (rnd.nextBoolean()) a.ab[m] else b.ab[m]
            }
            return c
        }

        fun serialize(b: Brain, dos: DataOutputStream) {
            dos.writeInt(b.inN); dos.writeInt(b.h1); dos.writeInt(b.h2); dos.writeInt(b.actN)
            fun w(a: DoubleArray) { for (v in a) dos.writeDouble(v) }
            for (j in 0 until b.h1) w(b.w1[j]); w(b.b1)
            for (j in 0 until b.h2) w(b.w2[j]); w(b.b2)
            w(b.va); dos.writeDouble(b.vb)
            for (m in 0 until b.actN) w(b.aa[m]); w(b.ab)
        }

        fun deserialize(dis: DataInputStream): Brain? = try {
            val inN = dis.readInt(); val h1 = dis.readInt(); val h2 = dis.readInt(); val actN = dis.readInt()
            if (inN <= 0 || h1 <= 0 || h2 <= 0 || actN <= 0) return null
            val b = Brain(inN, h1, h2, actN)
            fun r(a: DoubleArray) { for (i in a.indices) a[i] = dis.readDouble() }
            for (j in 0 until h1) r(b.w1[j]); r(b.b1)
            for (j in 0 until h2) r(b.w2[j]); r(b.b2)
            r(b.va); b.vb = dis.readDouble()
            for (m in 0 until actN) r(b.aa[m]); r(b.ab)
            b
        } catch (t: Throwable) { Log.w("SnakeAI", "deserialize failed", t); null }
    }
}

// ----------------------------- 15. 优先经验回放 ------------------------------

class ReplayBuffer(private val cap: Int = 20000) {
    class Transition(val s: DoubleArray, val a: Int, val r: Double, val ns: DoubleArray?, val done: Boolean)

    private val items = arrayOfNulls<Transition>(cap)
    private val prios = DoubleArray(cap)
    private var idx = 0
    var size = 0; private set
    private var maxPrio = 1.0

    fun add(s: DoubleArray, a: Int, r: Double, ns: DoubleArray?, done: Boolean) {
        items[idx] = Transition(s, a, r, ns, done)
        prios[idx] = maxPrio
        idx = (idx + 1) % cap
        if (size < cap) size++
    }

    fun sample(batch: Int, rnd: Random): List<Pair<Transition, Int>> {
        val n = size
        if (n == 0) return emptyList()
        var sum = 0.0
        val cum = DoubleArray(n)
        for (i in 0 until n) { sum += prios[i]; cum[i] = sum }
        val out = ArrayList<Pair<Transition, Int>>(batch)
        for (b in 0 until batch) {
            val target = rnd.nextDouble() * sum
            var lo = 0; var hi = n - 1
            while (lo < hi) { val mid = (lo + hi) / 2; if (cum[mid] < target) lo = mid + 1 else hi = mid }
            val t = items[lo] ?: continue
            out.add(t to lo)
        }
        return out
    }

    fun updatePrio(i: Int, td: Double) {
        val p = min(50.0, abs(td) + 0.01)
        prios[i] = p
        if (p > maxPrio) maxPrio = p
    }
}

// ----------------------------- 16. 神经进化（Brain + 基因组共进化）------------

class GaTrainer(private val popSize: Int = 24) {
    class Individual(val brain: Brain, val genome: V4StrategyGenome)

    var population = List(popSize) { Individual(Brain(), V4StrategyGenome()) }
    var generation = 0
    var championBrain: Brain? = null
    var championGenome: V4StrategyGenome? = null
    var championFitness = 0.0
    private val rnd = Random()

    fun evolve(eval: (Individual) -> Double): Pair<Individual, Double> {
        val fits = population.map { eval(it) }
        val order = population.indices.sortedByDescending { fits[it] }
        val bi = order.first()
        if (fits[bi] > championFitness) {
            championFitness = fits[bi]
            championBrain = population[bi].brain.cloneBrain()
            championGenome = population[bi].genome.clone()
        }
        val next = ArrayList<Individual>(popSize)
        val eliteN = max(2, popSize / 5)
        for (i in 0 until eliteN)
            next.add(Individual(population[order[i]].brain.cloneBrain(), population[order[i]].genome.clone()))
        val pool = order.take(max(2, popSize / 2))
        while (next.size < popSize) {
            val a = population[pool[rnd.nextInt(pool.size)]]
            val b = population[pool[rnd.nextInt(pool.size)]]
            next.add(Individual(
                Brain.crossover(a.brain, b.brain, rnd),
                V4StrategyGenome.crossover(a.genome, b.genome, rnd)
            ))
        }
        population = next
        generation++
        return next[0] to fits[bi]
    }
}

// ----------------------------- 17. DQN 训练器（策略仲裁）--------------------

class DqnTrainer {
    val online = Brain()
    val target = online.cloneBrain()
    val buffer = ReplayBuffer()
    var eps = 1.0
    var trainSteps = 0L
    var bestScore = 0
    var lastLoss = 0.0
    var lastPlannerDanger = 0.0   // 最近一次规划器选中动作的危险度
    var lastGoal = V4Goal.SURVIVE // 最近一次决策的主导目标
    private val rnd = Random()

    companion object {
        const val GAMMA = 0.92
        const val BATCH = 64
        const val WARMUP = 1500
        const val LR = 0.0025
    }

    /**
     * 决策仲裁：
     *  1) 规划器（多目标 + 基因 + 失败记忆）给基线
     *  2) 网络成熟后，按基因 dqnTrust 概率采纳网络动作（高危/即死一票否决）
     *  3) 探索仅在安全方向内随机（定向探索）
     */
    fun act(e: GameEngine, greedy: Boolean, genes: V4StrategyGenome, loop: LoopDetector, failure: V4FailureMemory): Int {
        val evals = MultiGoalPlanner.evaluate(e, genes, loop, failure)
        var plannerDir = e.dir; var bv = Double.NEGATIVE_INFINITY
        for (d in 0 until 4) if (evals[d].total > bv) { bv = evals[d].total; plannerDir = d }
        lastPlannerDanger = if (bv == Double.NEGATIVE_INFINITY) 1.0 else evals[plannerDir].danger
        lastGoal = evals[plannerDir].goal

        if (bv == Double.NEGATIVE_INFINITY) {
            for (d in 0 until 4) {
                if ((d + 2) % 4 == e.dir && e.snake.size > 1) continue
                return d
            }
            return e.dir
        }
        if (trainSteps < WARMUP) return plannerDir

        if (!greedy && rnd.nextDouble() < eps) {
            val safe = (0 until 4).filter { evals[it].total != Double.NEGATIVE_INFINITY }
            if (safe.isNotEmpty()) return safe[rnd.nextInt(safe.size)]
            return plannerDir
        }

        val q = online.forward(Features.extract(e, e.dir))
        var bestD = 0; var bqv = Double.NEGATIVE_INFINITY
        for (m in 0 until 4) if (q[m] > bqv) { bqv = q[m]; bestD = m }
        // 网络动作安全性否决 + 基因信任仲裁
        if (evals[bestD].total != Double.NEGATIVE_INFINITY &&
            evals[bestD].danger < 0.55 &&
            rnd.nextDouble() < genes.dqnTrust
        ) return bestD
        return plannerDir
    }

    fun reward(prevDist: Int, e: GameEngine, res: StepResult): Double = when (res) {
        StepResult.DIED -> -10.0
        StepResult.ATE -> 10.0
        StepResult.MOVED -> {
            val d = e.manhattanToFood(e.head().first, e.head().second)
            (prevDist - d) * 0.3 - 0.01
        }
    }

    fun learn(): Double {
        if (buffer.size < BATCH * 8) return 0.0
        val batch = buffer.sample(BATCH, rnd)
        var lossSum = 0.0
        val tds = ArrayList<Pair<Int, Double>>(BATCH)
        for ((t, i) in batch) {
            val tgt: Double
            if (t.done || t.ns == null) tgt = t.r
            else {
                val qOn = online.forward(t.ns)
                var aStar = 0; var bv = Double.NEGATIVE_INFINITY
                for (m in 0 until 4) if (qOn[m] > bv) { bv = qOn[m]; aStar = m }
                tgt = t.r + GAMMA * target.forward(t.ns)[aStar]
            }
            if (!tgt.isFinite()) continue
            val td = online.backward(t.s, t.a, tgt, 1.0)
            if (td.isFinite()) { tds.add(i to td); lossSum += min(abs(td), 10.0) }
        }
        online.applyGrads(LR, max(1, batch.size))
        for ((i, td) in tds) buffer.updatePrio(i, td)
        trainSteps++
        eps = max(0.02, eps * 0.9995)
        if (trainSteps % 400 == 0L) target.copyFrom(online)
        lastLoss = lossSum / max(1, batch.size)
        return lastLoss
    }
}

// ----------------------------- 18. 训练总控 -----------------------------------

class TrainingController(private val context: Context) {
    val dqn = DqnTrainer()
    val ga = GaTrainer()
    val failureMemory = V4FailureMemory()   // 失败长期记忆（全局共享）
    val dqnGenome = V4StrategyGenome()       // 策略基因（随死因自调整）
    private val running = AtomicBoolean(false)
    private val heartbeat = AtomicLong(0)
    private var executor: ExecutorService? = null
    private var watchdog: Thread? = null
    private var saveThread: Thread? = null
    private val lock = Any()
    private val rnd = Random()

    @Volatile var lastDeathReason = V4DeathReason.UNKNOWN
    @Volatile var currentGoal = V4Goal.SURVIVE

    val generation: Int get() = ga.generation

    data class Snapshot(
        val score: Int, val best: Int, val eps: Double,
        val trainSteps: Long, val gen: Int, val loss: Double,
        val buffer: Int, val gaChampFit: Double,
        val goal: V4Goal, val personality: String,
        val deathReason: V4DeathReason, val failMem: Int
    )

    fun snapshot(): Snapshot = synchronized(lock) {
        Snapshot(
            0, dqn.bestScore, dqn.eps, dqn.trainSteps, ga.generation, dqn.lastLoss,
            dqn.buffer.size, ga.championFitness,
            currentGoal, dqnGenome.personality(),
            lastDeathReason, failureMemory.size()
        )
    }

    fun start() {
        if (!running.compareAndSet(false, true)) return
        load()
        heartbeat.set(System.currentTimeMillis())
        val ex = Executors.newFixedThreadPool(4)
        executor = ex
        ex.submit { runDqn() }
        ex.submit { runDqn() }
        ex.submit { runGa() }
        val wd = Thread({
            while (running.get()) {
                try { Thread.sleep(15000) } catch (_: InterruptedException) { break }
                val stale = System.currentTimeMillis() - heartbeat.get()
                if (stale > 60000) {
                    Log.w("SnakeAI", "watchdog: heartbeat stale ${stale}ms, restarting tasks")
                    try { ex.submit { runDqn() } } catch (_: Throwable) {}
                }
            }
        }, "snake-watchdog")
        wd.isDaemon = true; wd.start(); watchdog = wd
        val sv = Thread({
            while (running.get()) {
                try { Thread.sleep(60000) } catch (_: InterruptedException) { break }
                save()
            }
        }, "snake-saver")
        sv.isDaemon = true; sv.start(); saveThread = sv
        Log.i("SnakeAI", "training started")
    }

    fun stop() {
        if (!running.compareAndSet(true, false)) return
        save()
        executor?.shutdownNow()
        watchdog?.interrupt()
        saveThread?.interrupt()
        executor = null; watchdog = null; saveThread = null
        Log.i("SnakeAI", "training stopped")
    }

    /** DQN 训练循环（2 线程并发） */
    private fun runDqn() {
        while (running.get()) {
            try {
                val e = GameEngine()
                e.reset()
                val loop = LoopDetector()
                val causal = CausalHistory()
                var localBest = 0
                while (e.alive && e.totalSteps < 2000) {
                    val s: DoubleArray
                    val a: Int
                    val prevDist: Int
                    synchronized(lock) {
                        prevDist = e.manhattanToFood(e.head().first, e.head().second)
                        s = Features.extract(e, e.dir)
                        a = dqn.act(e, greedy = false, dqnGenome, loop, failureMemory)
                        currentGoal = dqn.lastGoal
                    }
                    causal.record(e, a)
                    val res = e.step(a)
                    loop.record(e)
                    val r = dqn.reward(prevDist, e, res)
                    val ns = if (!e.alive) null else Features.extract(e, e.dir)
                    synchronized(lock) {
                        dqn.buffer.add(s, a, r, ns, !e.alive)
                        dqn.learn()
                    }
                    localBest = max(localBest, e.score)
                    heartbeat.set(System.currentTimeMillis())
                }
                synchronized(lock) {
                    if (!e.alive) reportDeathInternal(e.deathReason, causal, e, dqn.lastPlannerDanger)
                    if (localBest > dqn.bestScore) { dqn.bestScore = localBest; save() }
                }
            } catch (t: Throwable) {
                Log.w("SnakeAI", "dqn loop error", t)
                try { Thread.sleep(1000) } catch (_: InterruptedException) { return }
            }
        }
    }

    /** GA 训练循环（Brain + 基因组共进化） */
    private fun runGa() {
        while (running.get()) {
            try {
                Thread.sleep(3000)
                val eval: (GaTrainer.Individual) -> Double = { ind ->
                    var total = 0.0; var mx = 0
                    repeat(3) {
                        val e = GameEngine(); e.reset()
                        val loop = LoopDetector()
                        var steps = 0
                        while (e.alive && steps < 600) {
                            var a = MultiGoalPlanner.bestAction(e, ind.genome, loop, failureMemory)
                            // 大脑参与决策（共进化压力）
                            if (rnd.nextDouble() < ind.genome.dqnTrust * 0.5) {
                                val q = ind.brain.forward(Features.extract(e, e.dir))
                                var bd = a; var bqv = Double.NEGATIVE_INFINITY
                                for (m in 0 until 4) if (q[m] > bqv) { bqv = q[m]; bd = m }
                                if (bd != (e.dir + 2) % 4 || e.snake.size <= 1) a = bd
                            }
                            e.step(a)
                            loop.record(e)
                            steps++
                        }
                        total += e.score * 100.0 + steps * 0.02 + e.snake.size
                        mx = max(mx, e.score)
                    }
                    total / 3.0 + mx * 10.0
                }
                val (_, fit) = synchronized(lock) { ga.evolve(eval) }
                // GA 冠军注入：DQN 明显落后时整体迁移（大脑 + 基因组）
                val champBrain = ga.championBrain
                val champGenome = ga.championGenome
                if (champBrain != null && champGenome != null && fit > 150) synchronized(lock) {
                    val e = GameEngine(); e.reset()
                    var ds = 0
                    while (e.alive && ds < 600) {
                        val s = Features.extract(e, e.dir)
                        val q = dqn.online.forward(s)
                        var best = 0; var bv = Double.NEGATIVE_INFINITY
                        for (m in 0 until 4) if (q[m] > bv) { bv = q[m]; best = m }
                        e.step(best); ds++
                    }
                    if (e.score < 3) {
                        dqn.online.copyFrom(champBrain)
                        dqn.target.copyFrom(champBrain)
                        dqnGenome.copyFrom(champGenome)
                        Log.i("SnakeAI", "GA champion injected, fit=$fit")
                    }
                }
                heartbeat.set(System.currentTimeMillis())
            } catch (t: Throwable) {
                Log.w("SnakeAI", "ga loop error", t)
                try { Thread.sleep(2000) } catch (_: InterruptedException) { return }
            }
        }
    }

    /** 死亡反馈：死因 → 基因自调整 + 因果归因写入失败记忆 */
    private fun reportDeathInternal(
        reason: V4DeathReason, causal: CausalHistory, e: GameEngine, chosenDanger: Double
    ) {
        var r = reason
        if (r == V4DeathReason.UNKNOWN) r = V4DeathReason.SELF
        // 咬身且规划器当时就报警 → 归因为"被困"
        if (r == V4DeathReason.SELF && chosenDanger > 0.8) r = V4DeathReason.TRAP_PREDICTED
        lastDeathReason = r
        dqnGenome.adjust(r)  // 策略自调整
        causal.onDeath { cause, w ->
            if (w >= 0.4) { // 只记高责任步（约最近 6 步）
                failureMemory.record(cause.x, cause.y, cause.dir, cause.hash, r, e.snake.size)
            }
        }
    }

    /** View 线程上报死亡 */
    fun reportDeath(reason: V4DeathReason, causal: CausalHistory, e: GameEngine, chosenDanger: Double) {
        synchronized(lock) { reportDeathInternal(reason, causal, e, chosenDanger) }
    }

    fun lastActionDanger(): Double = synchronized(lock) { dqn.lastPlannerDanger }

    fun reportTransition(s: DoubleArray, a: Int, r: Double, ns: DoubleArray?, done: Boolean) {
        synchronized(lock) { dqn.buffer.add(s, a, r, ns, done) }
    }

    fun chooseDisplayAction(e: GameEngine, loop: LoopDetector): Int = synchronized(lock) {
        val a = dqn.act(e, greedy = false, dqnGenome, loop, failureMemory)
        currentGoal = dqn.lastGoal
        a
    }

    // -------- 持久化（原子写：tmp + rename，失败回滚；V2 格式含基因/记忆）--------

    private fun saveFile(): File = File(context.filesDir, "snake_ai_v4.dat")

    fun save() {
        synchronized(lock) {
            val f = saveFile()
            val tmp = File(context.filesDir, "snake_ai_v4.tmp")
            val bak = File(context.filesDir, "snake_ai_v4.bak")
            try {
                DataOutputStream(FileOutputStream(tmp).buffered()).use { dos ->
                    dos.writeInt(0x534E4B32) // magic "SNK2"
                    dos.writeDouble(dqn.eps)
                    dos.writeLong(dqn.trainSteps)
                    dos.writeInt(dqn.bestScore)
                    Brain.serialize(dqn.online, dos)
                    V4StrategyGenome.serialize(dqnGenome, dos)
                    val cb = ga.championBrain
                    val cg = ga.championGenome
                    if (cb != null && cg != null) {
                        dos.writeBoolean(true)
                        Brain.serialize(cb, dos)
                        V4StrategyGenome.serialize(cg, dos)
                        dos.writeDouble(ga.championFitness)
                    } else dos.writeBoolean(false)
                    dos.writeInt(ga.generation)
                    failureMemory.serialize(dos)
                }
                if (f.exists()) { bak.delete(); f.renameTo(bak) }
                if (!tmp.renameTo(f)) {
                    if (bak.exists()) { f.delete(); bak.renameTo(f) }
                    Log.w("SnakeAI", "save rename failed, rolled back")
                }
            } catch (t: Throwable) {
                Log.w("SnakeAI", "save failed", t)
                tmp.delete()
            }
        }
    }

    private fun load() {
        synchronized(lock) {
            val f = saveFile()
            if (!f.exists()) return
            try {
                DataInputStream(FileInputStream(f).buffered()).use { dis ->
                    if (dis.readInt() != 0x534E4B32) return
                    dqn.eps = dis.readDouble()
                    dqn.trainSteps = dis.readLong()
                    dqn.bestScore = dis.readInt()
                    Brain.deserialize(dis)?.let {
                        dqn.online.copyFrom(it); dqn.target.copyFrom(it)
                    }
                    V4StrategyGenome.deserialize(dis)?.let { dqnGenome.copyFrom(it) }
                    if (dis.readBoolean()) {
                        Brain.deserialize(dis)?.let { b -> ga.championBrain = b }
                        V4StrategyGenome.deserialize(dis)?.let { g -> ga.championGenome = g }
                        ga.championFitness = dis.readDouble()
                    }
                    ga.generation = dis.readInt()
                    failureMemory.deserialize(dis)
                }
                Log.i("SnakeAI", "loaded: best=${dqn.bestScore} steps=${dqn.trainSteps} gen=${ga.generation} mem=${failureMemory.size()}")
            } catch (t: Throwable) {
                Log.w("SnakeAI", "load failed", t)
            }
        }
    }
}

// ----------------------------- 19. UI / 渲染 ----------------------------------

class SnakeView @JvmOverloads constructor(
    context: Context, attrs: AttributeSet? = null
) : View(context, attrs) {

    private val engine = GameEngine()
    private val ai = TrainingController(context)

    // 显示局的循环检测 + 因果历史（每局重置）
    private val displayLoop = LoopDetector()
    private val displayCausal = CausalHistory()

    private var aiMode = true
    private var paused = false
    private var deathAt = 0L
    private var lastTapTime = 0L
    private var downX = 0f; private var downY = 0f

    private val moveIntervalMs = 120L
    private var stepAccum = 0L
    private var lastFrameTime = 0L
    private var frameCount = 0L

    private class Particle(var x: Float, var y: Float, var vx: Float, var vy: Float, var life: Float)
    private val particles = ArrayList<Particle>()
    private val random = Random()

    private val bgPaint = Paint().apply { color = Color.parseColor("#10151B") }
    private val gridPaint = Paint().apply { color = Color.parseColor("#1B2430"); strokeWidth = 1f }
    private val foodPaint = Paint().apply { color = Color.parseColor("#FF5252"); isAntiAlias = true }
    private val textPaint = Paint().apply {
        color = Color.parseColor("#E0E6ED"); textSize = 34f; isAntiAlias = true
    }
    private val hudBgPaint = Paint().apply { color = Color.parseColor("#88000000") }
    private val deadPaint = Paint().apply {
        color = Color.parseColor("#FF8A80"); textSize = 64f; isAntiAlias = true; textAlign = Paint.Align.CENTER
    }
    private val bodyPaint = Paint().apply { isAntiAlias = true }
    private val particlePaint = Paint().apply { isAntiAlias = true }

    private val frameCallback = Choreographer.FrameCallback { frameTime ->
        choreographerPost(frameTime)
        if (attached) Choreographer.getInstance().postFrameCallback(frameCallback)
    }
    private var attached = false

    init {
        engine.reset()
    }

    override fun onAttachedToWindow() {
        super.onAttachedToWindow()
        attached = true
        Choreographer.getInstance().postFrameCallback(frameCallback)
        ai.start()
    }

    override fun onDetachedFromWindow() {
        attached = false
        Choreographer.getInstance().removeCallbacks(frameCallback)
        ai.stop()
        super.onDetachedFromWindow()
    }

    private fun choreographerPost(frameTimeNanos: Long) {
        val now = frameTimeNanos / 1_000_000
        if (lastFrameTime == 0L) lastFrameTime = now
        val dt = min(100L, now - lastFrameTime)
        lastFrameTime = now
        frameCount++
        if (!paused && engine.alive) {
            stepAccum += dt
            while (stepAccum >= moveIntervalMs) {
                stepAccum -= moveIntervalMs
                tick()
                if (!engine.alive) { stepAccum = 0; break }
            }
        }
        if (!engine.alive && deathAt != 0L && now - deathAt > 1200) {
            deathAt = 0L
            engine.reset()
            displayLoop.reset()
            displayCausal.reset()
        }
        updateParticles(dt)
        invalidate()
    }

    private fun tick() {
        val prevDist = engine.manhattanToFood(engine.head().first, engine.head().second)
        val s = Features.extract(engine, engine.dir)
        val action = if (aiMode) ai.chooseDisplayAction(engine, displayLoop) else engine.dir
        displayCausal.record(engine, action)
        val res = engine.step(action)
        displayLoop.record(engine)
        val reward = when (res) {
            StepResult.DIED -> -10.0
            StepResult.ATE -> 10.0
            StepResult.MOVED -> {
                val d = engine.manhattanToFood(engine.head().first, engine.head().second)
                (prevDist - d) * 0.3 - 0.01
            }
        }
        val ns = if (!engine.alive) null else Features.extract(engine, engine.dir)
        if (aiMode) ai.reportTransition(s, action, reward, ns, !engine.alive)
        if (res == StepResult.ATE) spawnParticles(engine.food.first, engine.food.second)
        if (!engine.alive) {
            ai.reportDeath(engine.deathReason, displayCausal, engine, ai.lastActionDanger())
            deathAt = System.currentTimeMillis()
            spawnParticles(engine.head().first, engine.head().second, big = true)
        }
    }

    private fun spawnParticles(gx: Int, gy: Int, big: Boolean = false) {
        val cell = cellSize()
        val n = if (big) 26 else 12
        repeat(n) {
            val ang = random.nextFloat() * (Math.PI * 2).toFloat()
            val spd = if (big) 0.20f else 0.10f
            particles.add(Particle(
                (gx + 0.5f) * cell, (gy + 0.5f) * cell,
                kotlin.math.cos(ang) * spd * cell, kotlin.math.sin(ang) * spd * cell,
                if (big) 1.0f else 0.6f
            ))
        }
    }

    private fun updateParticles(dt: Float) {
        val it = particles.iterator()
        while (it.hasNext()) {
            val p = it.next()
            p.x += p.vx * dt; p.y += p.vy * dt
            p.life -= dt / 600f
            if (p.life <= 0) it.remove()
        }
    }

    // -------- 触摸：滑动转向（手动）/ 单击暂停 / 双击切 AI --------

    override fun onTouchEvent(event: MotionEvent): Boolean {
        when (event.actionMasked) {
            MotionEvent.ACTION_DOWN -> { downX = event.x; downY = event.y; return true }
            MotionEvent.ACTION_UP -> {
                val dx = event.x - downX; val dy = event.y - downY
                val dist = max(abs(dx), abs(dy))
                if (dist < 30f) {
                    val now = System.currentTimeMillis()
                    if (now - lastTapTime < 300) {
                        aiMode = !aiMode; lastTapTime = 0
                    } else {
                        lastTapTime = now; paused = !paused
                    }
                } else if (!aiMode) {
                    val d = if (abs(dx) > abs(dy)) (if (dx > 0) 1 else 3) else (if (dy > 0) 2 else 0)
                    engine.dir = d
                }
                performClick()
                return true
            }
        }
        return super.onTouchEvent(event)
    }

    // -------- 绘制 --------

    private fun boardRect(): RectF {
        val size = min(width, height).toFloat() - 16f
        val ox = (width - size) / 2f
        val oy = (height - size) / 2f
        return RectF(ox, oy, ox + size, oy + size)
    }

    private fun cellSize(): Float = boardRect().width() / engine.w

    override fun onDraw(canvas: Canvas) {
        canvas.drawRect(0f, 0f, width.toFloat(), height.toFloat(), bgPaint)
        val board = boardRect()
        val cell = cellSize()

        // 网格
        for (i in 0..engine.w) {
            val x = board.left + i * cell
            canvas.drawLine(x, board.top, x, board.bottom, gridPaint)
            canvas.drawLine(board.left, board.top + i * cell, board.right, board.top + i * cell, gridPaint)
        }

        // 食物（呼吸脉动）
        val pulse = (sin(frameCount * 0.08f) + 1f) / 2f
        val fr = engine.food
        val fx = board.left + (fr.first + 0.5f) * cell
        val fy = board.top + (fr.second + 0.5f) * cell
        foodPaint.alpha = (180 + pulse * 75).toInt()
        canvas.drawCircle(fx, fy, cell * (0.32f + pulse * 0.06f), foodPaint)
        foodPaint.alpha = 255

        // 蛇（头亮尾暗渐变）
        var idx = 0
        val n = engine.snake.size
        for (c in engine.snake) {
            val t = idx.toFloat() / max(1, n - 1)
            val green = ((1f - t) * 0.75f + 0.25f) * 255
            val red = (0.35f * 255 * (1 - t * 0.5f)).toInt()
            bodyPaint.color = Color.rgb(red, green.toInt(), (red * 0.45f).coerceAtMost(255f).toInt())
            val left = board.left + c.first * cell + cell * 0.08f
            val top = board.top + c.second * cell + cell * 0.08f
            canvas.drawRoundRect(left, top, left + cell * 0.84f, top + cell * 0.84f, cell * 0.25f, cell * 0.25f, bodyPaint)
            idx++
        }

        // 粒子
        for (p in particles) {
            particlePaint.color = Color.argb((p.life * 255).toInt().coerceIn(0, 255), 255, 200, 100)
            canvas.drawCircle(p.x, p.y, cell * 0.12f * p.life, particlePaint)
        }

        // HUD（V4 全量状态）
        val snap = ai.snapshot()
        val lines = listOf(
            "模式: ${if (aiMode) "AI" else "手动"}${if (paused) " | 已暂停" else ""}",
            "本局: ${engine.score}  最高: ${snap.best}",
            "目标: ${goalLabel(snap.goal)}  性格: ${snap.personality}",
            "死因: ${reasonLabel(snap.deathReason)}  失败记忆: ${snap.failMem}",
            "代: ${snap.gen}  步: ${snap.trainSteps}",
            "ε: ${"%.3f".format(snap.eps)}  loss: ${"%.3f".format(snap.loss)}",
            "GA冠军: ${snap.gaChampFit.toInt()}  回放池: ${snap.buffer}"
        )
        val pad = 24f
        var ty = pad + 40f
        canvas.drawRect(0f, 0f, 520f, pad + lines.size * 44f + 8f, hudBgPaint)
        for (line in lines) { canvas.drawText(line, pad, ty, textPaint); ty += 44f }

        if (!engine.alive) {
            canvas.drawText("蛇挂了… 重启中", width / 2f, height / 2f, deadPaint)
        }
    }
}
